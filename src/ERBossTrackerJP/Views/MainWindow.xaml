<Window x:Class="ERBossTrackerJP.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="1280"
        Height="800"
        MinWidth="960"
        MinHeight="640"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="PanelBorderStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="CornerRadius"
                    Value="7" />
            <Setter Property="Padding"
                    Value="14" />
        </Style>
        <Style x:Key="SummaryCardStyle"
               TargetType="Border"
               BasedOn="{StaticResource PanelBorderStyle}">
            <Setter Property="Margin"
                    Value="0,0,10,0" />
            <Setter Property="Padding"
                    Value="14,10" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight"
                    Value="34" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Center" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="Padding"
                    Value="14,6" />
            <Setter Property="Background"
                    Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource SelectionBrush}" />
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource DisabledTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ComboBoxToggleButtonStyle"
               TargetType="ToggleButton">
            <Setter Property="Focusable"
                    Value="False" />
            <Setter Property="ClickMode"
                    Value="Press" />
            <Setter Property="Background"
                    Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="34" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="1"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1,0,0,0" />
                                <Path Grid.Column="1"
                                      Width="9"
                                      Height="5"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M 0 0 L 4.5 5 L 9 0 Z"
                                      Fill="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ToggleBorder"
                                        Property="Background"
                                        Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter TargetName="ToggleBorder"
                                        Property="Background"
                                        Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight"
                    Value="34" />
            <Setter Property="MaxDropDownHeight"
                    Value="320" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="SnapsToDevicePixels"
                    Value="True" />
            <Setter Property="ScrollViewer.CanContentScroll"
                    Value="True" />
            <Setter Property="Background"
                    Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Style="{StaticResource ComboBoxToggleButtonStyle}" />
                            <ContentPresenter Margin="10,0,38,0"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              IsHitTestVisible="False"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Grid MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                      SnapsToDevicePixels="True">
                                    <Border Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" />
                                    <ScrollViewer Margin="1"
                                                  SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin"
                                     Value="True">
                                <Setter TargetName="DropDownToggle"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Foreground"
                            Value="{DynamicResource DisabledTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight"
                    Value="34" />
            <Setter Property="Padding"
                    Value="8,5" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="Background"
                    Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}" />
            <Setter Property="CaretBrush"
                    Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="SelectionBrush"
                    Value="{DynamicResource SelectionBrush}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Foreground"
                            Value="{DynamicResource DisabledTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Foreground"
                            Value="{DynamicResource DisabledTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding"
                    Value="8,5" />
            <Setter Property="Background"
                    Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource ControlHoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource SelectionBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns"
                    Value="False" />
            <Setter Property="CanUserAddRows"
                    Value="False" />
            <Setter Property="CanUserDeleteRows"
                    Value="False" />
            <Setter Property="GridLinesVisibility"
                    Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush"
                    Value="{DynamicResource GridLineBrush}" />
            <Setter Property="HeadersVisibility"
                    Value="Column" />
            <Setter Property="IsReadOnly"
                    Value="True" />
            <Setter Property="RowHeaderWidth"
                    Value="0" />
            <Setter Property="RowHeight"
                    Value="30" />
            <Setter Property="AlternatingRowBackground"
                    Value="{DynamicResource SurfaceAlternateBrush}" />
            <Setter Property="RowBackground"
                    Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Background"
                    Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"
                    Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}" />
            <Setter Property="Padding"
                    Value="8,6" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource ControlHoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource SelectionBrush}" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource TextPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource GridLineBrush}" />
            <Style.Triggers>
                <Trigger Property="IsSelected"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource SelectionBrush}" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource TextPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Background"
                    Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}" />
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="0" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground"
                    Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Padding"
                    Value="18,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter Property="FontWeight"
                                        Value="SemiBold" />
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="{DynamicResource ControlBackgroundBrush}" />
                                <Setter TargetName="TabBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <TextBlock FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="ER Boss Tracker JP" />
                <TextBlock Margin="14,5,0,0"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="ELDEN RING ボス撃破状況" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <TextBlock FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding MonitoringStatusText}" />
                <TextBlock Margin="16,0,0,0"
                           Foreground="{DynamicResource TextMutedBrush}">
                    <Run Text="最終正常更新: " />
                    <Run FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         Text="{Binding TrackerLastUpdateText, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Margin="16,0,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}">
                    <Run Text="OBS出力: " />
                    <Run FontWeight="SemiBold"
                         Text="{Binding ObsOutputStatusText, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1">
            <TabItem Header="進捗">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,8"
                Padding="10"
                Style="{StaticResource PanelBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Row="0"
                          Grid.Column="0"
                          Margin="0,0,10,0"
                          DisplayMemberPath="FilePath"
                          IsEnabled="{Binding IsInteractionEnabled}"
                          ItemsSource="{Binding SaveCandidates}"
                          SelectedItem="{Binding SelectedSaveCandidate, Mode=TwoWay}" />
                <Button Grid.Row="0"
                        Grid.Column="1"
                        MinWidth="96"
                        Margin="0,0,8,0"
                        Command="{Binding ReloadCommand}"
                        Content="再読み込み" />
                <Button Grid.Row="0"
                        Grid.Column="2"
                        MinWidth="110"
                        Margin="0,0,8,0"
                        Command="{Binding BrowseFolderCommand}"
                        Content="フォルダーを選択" />
                <Button Grid.Row="0"
                        Grid.Column="3"
                        MinWidth="120"
                        Margin="0,0,14,0"
                        Command="{Binding RefreshDefaultCommand}"
                        Content="既定場所を再検索" />
                <CheckBox Grid.Row="0"
                          Grid.Column="4"
                          VerticalAlignment="Center"
                          IsChecked="{Binding IsAutoMonitoringEnabled, Mode=TwoWay}"
                          IsEnabled="{Binding IsInteractionEnabled}"
                          Content="自動監視" />

                <DockPanel Grid.Row="1"
                           Grid.Column="0"
                           Grid.ColumnSpan="5"
                           Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Right"
                               Margin="16,0,0,0"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="セーブファイルは読み取り専用で扱います。" />
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding StatusMessage}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProgressStatusMessageVisible}"
                                                 Value="False">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,10,0"
                    Padding="10,8"
                    Style="{StaticResource PanelBorderStyle}">
                <StackPanel>
                    <TextBlock Margin="0,0,0,6"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="キャラクター" />
                    <ComboBox ItemsSource="{Binding CharacterSlots}"
                              IsEnabled="{Binding IsInteractionEnabled}"
                              SelectedItem="{Binding SelectedCharacter, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="スロット " />
                                    <Run Text="{Binding SlotNumber, Mode=OneWay}" />
                                    <Run Text="  " />
                                    <Run FontWeight="SemiBold"
                                         Text="{Binding Name, Mode=OneWay}" />
                                    <Run Text="  Lv." />
                                    <Run Text="{Binding Level, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Padding="10,7"
                    Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource TextMutedBrush}"
                               Text="撃破済み" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SuccessBrush}"
                               Text="{Binding Defeated}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2"
                    Padding="10,7"
                    Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource TextMutedBrush}"
                               Text="未撃破" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource WarningBrush}"
                               Text="{Binding Remaining}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3"
                    Padding="10,7"
                    Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource TextMutedBrush}"
                               Text="総数" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               Text="{Binding Total}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4"
                    Padding="10,8"
                    Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0"
                               Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Right"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Text="{Binding ProgressPercentageText}" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="進捗率" />
                    </DockPanel>
                    <ProgressBar Grid.Row="1"
                                 Height="14"
                                 Maximum="100"
                                 Value="{Binding ProgressPercentage, Mode=OneWay}" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Margin="0,0,0,8"
                Padding="10"
                Style="{StaticResource PanelBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="0,0,12,0">
                    <TextBlock Margin="0,0,0,4"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="ボス名検索" />
                    <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Margin="0,0,12,0">
                    <TextBlock Margin="0,0,0,4"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="撃破状態" />
                    <ComboBox DisplayMemberPath="Label"
                              ItemsSource="{Binding CompletionOptions}"
                              SelectedValue="{Binding CompletionFilter, Mode=TwoWay}"
                              SelectedValuePath="Value" />
                </StackPanel>
                <StackPanel Grid.Column="2"
                            Margin="0,0,12,0">
                    <TextBlock Margin="0,0,0,4"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="対象" />
                    <ComboBox DisplayMemberPath="Label"
                              ItemsSource="{Binding ContentOptions}"
                              SelectedItem="{Binding SelectedContentOption, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="3"
                            Margin="0,0,12,0">
                    <TextBlock Margin="0,0,0,4"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="地域" />
                    <ComboBox DisplayMemberPath="Label"
                              ItemsSource="{Binding RegionOptions}"
                              SelectedItem="{Binding SelectedRegionOption, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Margin="0,0,0,4"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="固有名詞" />
                    <ComboBox DisplayMemberPath="Label"
                              ItemsSource="{Binding LanguageOptions}"
                              SelectedValue="{Binding DisplayLanguage, Mode=TwoWay}"
                              SelectedValuePath="Value" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="0"
                    Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Margin="14,12,14,10"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Text="地域別進捗" />
                    <DataGrid Grid.Row="1"
                              BorderThickness="0"
                              ItemsSource="{Binding Regions}"
                              SelectedItem="{Binding SelectedRegion, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*"
                                                Header="地域"
                                                Binding="{Binding Name, Mode=OneWay}" />
                            <DataGridTextColumn Width="62"
                                                Header="撃破"
                                                Binding="{Binding Defeated, Mode=OneWay}" />
                            <DataGridTextColumn Width="62"
                                                Header="総数"
                                                Binding="{Binding Total, Mode=OneWay}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="0"
                    Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0"
                               Margin="14,12,14,10">
                        <TextBlock DockPanel.Dock="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{Binding VisibleBossCountText}" />
                        <TextBlock FontSize="17"
                                   FontWeight="SemiBold"
                                   Text="ボス一覧" />
                    </DockPanel>
                    <DataGrid Grid.Row="1"
                              BorderThickness="0"
                              ItemsSource="{Binding Bosses}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="88"
                                                    Header="状態">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource WarningBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDefeated}"
                                                                     Value="True">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource SuccessBrush}" />
                                                            <Setter Property="FontWeight"
                                                                    Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="2*"
                                                MinWidth="180"
                                                Header="ボス名"
                                                Binding="{Binding Name, Mode=OneWay}" />
                            <DataGridTextColumn Width="1.4*"
                                                MinWidth="140"
                                                Header="地域"
                                                Binding="{Binding Region, Mode=OneWay}" />
                            <DataGridTextColumn Width="1.6*"
                                                MinWidth="160"
                                                Header="場所"
                                                Binding="{Binding Location, Mode=OneWay}" />
                            <DataGridTextColumn Width="70"
                                                Header="区分"
                                                Binding="{Binding ContentText, Mode=OneWay}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

                </Grid>
            </TabItem>

            <TabItem Header="OBS出力">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Margin="0,0,0,12"
                                Style="{StaticResource PanelBorderStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right"
                                            HorizontalAlignment="Right">
                                    <TextBlock HorizontalAlignment="Right"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Text="最終出力" />
                                    <TextBlock HorizontalAlignment="Right"
                                               FontWeight="SemiBold"
                                               Text="{Binding ObsLastOutputTimeText}" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                    <CheckBox Margin="0,0,18,0"
                                              Content="OBSテキスト出力を有効にする"
                                              IsChecked="{Binding IsObsOutputEnabled, Mode=TwoWay}"
                                              IsEnabled="{Binding IsInteractionEnabled}" />
                                    <TextBlock Foreground="{DynamicResource TextMutedBrush}"
                                               Text="状態: " />
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding ObsOutputStatusText}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="0.95*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource PanelBorderStyle}">
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,16"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Text="基本設定" />

                                    <TextBlock Margin="0,0,0,4"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Text="出力先" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Margin="0,0,8,0"
                                                 IsReadOnly="True"
                                                 Text="{Binding ObsOutputDirectory, Mode=OneWay}"
                                                 ToolTip="{Binding ObsOutputDirectory}" />
                                        <Button Grid.Column="1"
                                                MinWidth="104"
                                                Command="{Binding BrowseObsOutputFolderCommand}"
                                                Content="出力先を選択" />
                                    </Grid>

                                    <TextBlock Margin="0,14,0,4"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Text="OBSで読み込む推奨ファイル" />
                                    <TextBox IsReadOnly="True"
                                             Text="{Binding ObsRecommendedProgressFilePath, Mode=OneWay}"
                                             ToolTip="{Binding ObsRecommendedProgressFilePath}" />
                                    <TextBlock Margin="0,5,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="通常はこの progress.txt を、OBSの［テキスト（GDI+）］で［ファイルから読み取り］に指定します。他のファイルは数値を個別表示するときに使用します。"
                                               TextWrapping="Wrap" />

                                    <TextBlock Margin="0,16,0,4"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Text="固有名詞の言語（画面とOBS共通）" />
                                    <ComboBox DisplayMemberPath="Label"
                                              ItemsSource="{Binding LanguageOptions}"
                                              SelectedValue="{Binding DisplayLanguage, Mode=TwoWay}"
                                              SelectedValuePath="Value" />

                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Padding="0"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource PanelBorderStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0"
                                               Margin="14,12,14,10">
                                        <TextBlock DockPanel.Dock="Right"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="現在の内容" />
                                        <TextBlock FontSize="17"
                                                   FontWeight="SemiBold"
                                                   Text="OBS出力ファイルのプレビュー" />
                                    </DockPanel>
                                    <Border Grid.Row="1"
                                            Padding="14,10"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,1,0,0">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="progress.txt の表示書式" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Text="使用可能: {defeated}  {remaining}  {total}  {percentage}（%記号は書式側へ入力）"
                                                       TextWrapping="Wrap" />
                                            <TextBox Margin="0,7,0,0"
                                                     MaxLength="256"
                                                     Text="{Binding ObsProgressFormatDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Margin="0,5,0,0"
                                                       AutomationProperties.LiveSetting="Polite"
                                                       Foreground="{DynamicResource WarningBrush}"
                                                       Text="{Binding ObsProgressFormatStatusText}"
                                                       TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsObsProgressFormatErrorVisible}"
                                                                         Value="True">
                                                                <Setter Property="Visibility"
                                                                        Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <DockPanel Margin="0,8,0,0">
                                                <StackPanel DockPanel.Dock="Right"
                                                            Orientation="Horizontal">
                                                    <Button Width="132"
                                                            Command="{Binding ApplyObsProgressFormatCommand}"
                                                            Content="書式を適用"
                                                            ToolTip="書式を保存して反映します。OBS出力が有効なら現在値も同時に更新します。" />
                                                    <Button Width="132"
                                                            Margin="8,0,0,0"
                                                            Command="{Binding TestObsOutputCommand}"
                                                            Content="現在値を再出力"
                                                            ToolTip="書式適用とは別に、現在の進捗をOBS用ファイルへ書き直します。出力確認や失敗後の再試行に使用します。" />
                                                </StackPanel>
                                                <TextBlock Margin="0,0,10,0"
                                                           VerticalAlignment="Center"
                                                           AutomationProperties.LiveSetting="Polite"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding ObsProgressFormatStatusText}"
                                                           TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource WarningBrush}" />
                                                            <Setter Property="Visibility"
                                                                    Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsObsProgressFormatActionStatusVisible}"
                                                                             Value="True">
                                                                    <Setter Property="Visibility"
                                                                            Value="Visible" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsObsProgressFormatStatusSuccess}"
                                                                             Value="True">
                                                                    <Setter Property="Foreground"
                                                                            Value="{DynamicResource SuccessBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                    <DataGrid Grid.Row="2"
                                              Margin="14,0,14,14"
                                              VerticalAlignment="Top"
                                              BorderThickness="1"
                                              ItemsSource="{Binding ObsPreviewItems}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Width="145"
                                                                Header="ファイル名"
                                                                Binding="{Binding FileName, Mode=OneWay}" />
                                            <DataGridTextColumn Width="190"
                                                                Header="用途"
                                                                Binding="{Binding Usage, Mode=OneWay}" />
                                            <DataGridTextColumn Width="*"
                                                                Header="現在の内容"
                                                                Binding="{Binding Contents, Mode=OneWay}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="設定">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.85*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1.15*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource PanelBorderStyle}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,10"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Text="セーブファイルと監視" />
                            <TextBlock Margin="0,0,0,4"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="セーブファイル" />
                            <ComboBox DisplayMemberPath="FilePath"
                                      IsEnabled="{Binding IsInteractionEnabled}"
                                      ItemsSource="{Binding SaveCandidates}"
                                      SelectedItem="{Binding SelectedSaveCandidate, Mode=TwoWay}"
                                      ToolTip="{Binding SelectedSaveCandidate.FilePath}" />
                            <WrapPanel Margin="0,8,0,0">
                                <Button MinWidth="88"
                                        Margin="0,0,8,0"
                                        Command="{Binding ReloadCommand}"
                                        Content="再読み込み" />
                                <Button Margin="0,0,8,0"
                                        Command="{Binding BrowseFolderCommand}"
                                        Content="フォルダーを選択" />
                                <Button Command="{Binding RefreshDefaultCommand}"
                                        Content="既定場所を再検索" />
                            </WrapPanel>
                            <TextBlock Margin="0,10,0,4"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="キャラクター" />
                            <ComboBox ItemsSource="{Binding CharacterSlots}"
                                      IsEnabled="{Binding IsInteractionEnabled}"
                                      SelectedItem="{Binding SelectedCharacter, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="スロット " />
                                            <Run Text="{Binding SlotNumber, Mode=OneWay}" />
                                            <Run Text="  " />
                                            <Run FontWeight="SemiBold"
                                                 Text="{Binding Name, Mode=OneWay}" />
                                            <Run Text="  Lv." />
                                            <Run Text="{Binding Level, Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <CheckBox Margin="0,10,0,0"
                                      Content="自動監視"
                                      IsChecked="{Binding IsAutoMonitoringEnabled, Mode=TwoWay}"
                                      IsEnabled="{Binding IsInteractionEnabled}" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="セーブ更新を検出すると自動で再読み込みします。セーブファイルは読み取り専用で扱います。"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,12,0,0"
                            VerticalAlignment="Top"
                            Style="{StaticResource PanelBorderStyle}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,12"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Text="表示設定" />
                            <CheckBox Content="ダークモード"
                                      IsChecked="{Binding IsDarkMode, Mode=TwoWay}" />
                            <TextBlock Margin="0,12,0,4"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="固有名詞" />
                            <ComboBox DisplayMemberPath="Label"
                                      ItemsSource="{Binding LanguageOptions}"
                                      SelectedValue="{Binding DisplayLanguage, Mode=TwoWay}"
                                      SelectedValuePath="Value" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="2"
                            Style="{StaticResource PanelBorderStyle}">
                        <StackPanel>
                            <TextBlock FontSize="17"
                                       FontWeight="SemiBold"
                                       Text="OBS出力設定" />
                            <CheckBox Margin="0,10,0,0"
                                      Content="OBSテキスト出力を有効にする"
                                      IsChecked="{Binding IsObsOutputEnabled, Mode=TwoWay}"
                                      IsEnabled="{Binding IsInteractionEnabled}" />
                            <TextBlock Margin="0,8,0,4"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="出力先" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Margin="0,0,8,0"
                                         IsReadOnly="True"
                                         Text="{Binding ObsOutputDirectory, Mode=OneWay}"
                                         ToolTip="{Binding ObsOutputDirectory}" />
                                <Button Grid.Column="1"
                                        MinWidth="104"
                                        Command="{Binding BrowseObsOutputFolderCommand}"
                                        Content="出力先を選択" />
                            </Grid>
                            <TextBlock Margin="0,10,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="progress.txt の表示書式" />
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="使用可能: {defeated}  {remaining}  {total}  {percentage}"
                                       TextWrapping="Wrap" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Margin="0,0,8,0"
                                         MaxLength="256"
                                         Text="{Binding ObsProgressFormatDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1"
                                        MinWidth="112"
                                        Command="{Binding ApplyObsProgressFormatCommand}"
                                        Content="書式を適用" />
                            </Grid>
                            <TextBlock Margin="0,4,0,0"
                                       AutomationProperties.LiveSetting="Polite"
                                       Text="{Binding ObsProgressFormatStatusText}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource WarningBrush}" />
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsObsProgressFormatStatusVisible}"
                                                         Value="True">
                                                <Setter Property="Visibility"
                                                        Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsObsProgressFormatStatusSuccess}"
                                                         Value="True">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource SuccessBrush}" />
                                                <Setter Property="FontWeight"
                                                        Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Margin="0,12,0,0"
                            Style="{StaticResource PanelBorderStyle}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       VerticalAlignment="Center"
                                       Text="{Binding SettingsSaveStatusText}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSettingsSaveError}"
                                                         Value="True">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource WarningBrush}" />
                                                <Setter Property="FontWeight"
                                                        Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel>
                                <TextBlock FontSize="17"
                                           FontWeight="SemiBold"
                                           Text="アプリ情報" />
                                <StackPanel Margin="0,6,0,0"
                                            Orientation="Horizontal">
                                    <TextBlock FontWeight="SemiBold"
                                               Text="ER Boss Tracker JP" />
                                    <TextBlock Margin="12,0,0,0"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Text="{Binding ApplicationVersionText}" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
