<Window x:Class="ERBossTrackerJP.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="1280"
        Height="800"
        MinWidth="960"
        MinHeight="640"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="PanelBorderStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="CornerRadius"
                    Value="7" />
            <Setter Property="Padding"
                    Value="14" />
        </Style>
        <Style x:Key="SummaryCardStyle"
               TargetType="Border"
               BasedOn="{StaticResource PanelBorderStyle}">
            <Setter Property="Margin"
                    Value="0,0,10,0" />
            <Setter Property="Padding"
                    Value="14,10" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight"
                    Value="34" />
            <Setter Property="Padding"
                    Value="14,6" />
            <Setter Property="Background"
                    Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource ControlHoverBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Foreground"
                            Value="{DynamicResource DisabledTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ComboBoxToggleButtonStyle"
               TargetType="ToggleButton">
            <Setter Property="Focusable"
                    Value="False" />
            <Setter Property="ClickMode"
                    Value="Press" />
            <Setter Property="Background"
                    Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="34" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="1"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1,0,0,0" />
                                <Path Grid.Column="1"
                                      Width="9"
                                      Height="5"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M 0 0 L 4.5 5 L 9 0 Z"
                                      Fill="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ToggleBorder"
                                        Property="Background"
                                        Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter TargetName="ToggleBorder"
                                        Property="Background"
                                        Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight"
                    Value="34" />
            <Setter Property="MaxDropDownHeight"
                    Value="320" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="SnapsToDevicePixels"
                    Value="True" />
            <Setter Property="ScrollViewer.CanContentScroll"
                    Value="True" />
            <Setter Property="Background"
                    Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Style="{StaticResource ComboBoxToggleButtonStyle}" />
                            <ContentPresenter Margin="10,0,38,0"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              IsHitTestVisible="False"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Grid MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                      SnapsToDevicePixels="True">
                                    <Border Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" />
                                    <ScrollViewer Margin="1"
                                                  SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin"
                                     Value="True">
                                <Setter TargetName="DropDownToggle"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Foreground"
                            Value="{DynamicResource DisabledTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight"
                    Value="34" />
            <Setter Property="Padding"
                    Value="8,5" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="Background"
                    Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}" />
            <Setter Property="CaretBrush"
                    Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="SelectionBrush"
                    Value="{DynamicResource SelectionBrush}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Foreground"
                            Value="{DynamicResource DisabledTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Foreground"
                            Value="{DynamicResource DisabledTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding"
                    Value="8,5" />
            <Setter Property="Background"
                    Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource ControlHoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource SelectionBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns"
                    Value="False" />
            <Setter Property="CanUserAddRows"
                    Value="False" />
            <Setter Property="CanUserDeleteRows"
                    Value="False" />
            <Setter Property="GridLinesVisibility"
                    Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush"
                    Value="{DynamicResource GridLineBrush}" />
            <Setter Property="HeadersVisibility"
                    Value="Column" />
            <Setter Property="IsReadOnly"
                    Value="True" />
            <Setter Property="RowHeaderWidth"
                    Value="0" />
            <Setter Property="RowHeight"
                    Value="30" />
            <Setter Property="AlternatingRowBackground"
                    Value="{DynamicResource SurfaceAlternateBrush}" />
            <Setter Property="RowBackground"
                    Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Background"
                    Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"
                    Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}" />
            <Setter Property="Padding"
                    Value="8,6" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource ControlHoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource SelectionBrush}" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource TextPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource GridLineBrush}" />
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Background"
                    Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}" />
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="0" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground"
                    Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Padding"
                    Value="18,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter Property="FontWeight"
                                        Value="SemiBold" />
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="{DynamicResource ControlBackgroundBrush}" />
                                <Setter TargetName="TabBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0"
                   Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="ER Boss Tracker JP" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="ELDEN RING ボス撃破状況" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right"
                        HorizontalAlignment="Right">
                <TextBlock HorizontalAlignment="Right"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding MonitoringStatusText}" />
                <TextBlock HorizontalAlignment="Right"
                           Margin="0,3,0,0"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="最終正常更新" />
                <TextBlock HorizontalAlignment="Right"
                           FontWeight="SemiBold"
                           Text="{Binding TrackerLastUpdateText}" />
                <TextBlock HorizontalAlignment="Right"
                           Margin="0,5,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}">
                    <Run Text="OBS出力: " />
                    <Run FontWeight="SemiBold"
                         Text="{Binding ObsOutputStatusText, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="進捗">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,12"
                Style="{StaticResource PanelBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Row="0"
                          Grid.Column="0"
                          Margin="0,0,10,0"
                          DisplayMemberPath="FilePath"
                          IsEnabled="{Binding IsInteractionEnabled}"
                          ItemsSource="{Binding SaveCandidates}"
                          SelectedItem="{Binding SelectedSaveCandidate, Mode=TwoWay}" />
                <Button Grid.Row="0"
                        Grid.Column="1"
                        MinWidth="96"
                        Margin="0,0,8,0"
                        Command="{Binding ReloadCommand}"
                        Content="再読み込み" />
                <Button Grid.Row="0"
                        Grid.Column="2"
                        MinWidth="110"
                        Margin="0,0,8,0"
                        Command="{Binding BrowseFolderCommand}"
                        Content="フォルダー参照" />
                <Button Grid.Row="0"
                        Grid.Column="3"
                        MinWidth="120"
                        Margin="0,0,14,0"
                        Command="{Binding RefreshDefaultCommand}"
                        Content="既定場所を再検索" />
                <CheckBox Grid.Row="0"
                          Grid.Column="4"
                          VerticalAlignment="Center"
                          IsChecked="{Binding IsAutoMonitoringEnabled, Mode=TwoWay}"
                          IsEnabled="{Binding IsInteractionEnabled}"
                          Content="自動監視" />

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Grid.ColumnSpan="5"
                           Margin="0,10,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding StatusMessage}"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,10,0"
                    Style="{StaticResource PanelBorderStyle}">
                <StackPanel>
                    <TextBlock Margin="0,0,0,6"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="キャラクター" />
                    <ComboBox ItemsSource="{Binding CharacterSlots}"
                              IsEnabled="{Binding IsInteractionEnabled}"
                              SelectedItem="{Binding SelectedCharacter, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="スロット " />
                                    <Run Text="{Binding SlotNumber, Mode=OneWay}" />
                                    <Run Text="  " />
                                    <Run FontWeight="SemiBold"
                                         Text="{Binding Name, Mode=OneWay}" />
                                    <Run Text="  Lv." />
                                    <Run Text="{Binding Level, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource TextMutedBrush}"
                               Text="撃破済み" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SuccessBrush}"
                               Text="{Binding Defeated}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2"
                    Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource TextMutedBrush}"
                               Text="未撃破" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource WarningBrush}"
                               Text="{Binding Remaining}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3"
                    Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource TextMutedBrush}"
                               Text="総数" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               Text="{Binding Total}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4"
                    Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0"
                               Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Right"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Text="{Binding ProgressPercentageText}" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="進捗率" />
                    </DockPanel>
                    <ProgressBar Grid.Row="1"
                                 Height="14"
                                 Maximum="100"
                                 Value="{Binding ProgressPercentage, Mode=OneWay}" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Margin="0,0,0,12"
                Style="{StaticResource PanelBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="0,0,12,0">
                    <TextBlock Margin="0,0,0,4"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="ボス名検索" />
                    <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Margin="0,0,12,0">
                    <TextBlock Margin="0,0,0,4"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="撃破状態" />
                    <ComboBox DisplayMemberPath="Label"
                              ItemsSource="{Binding CompletionOptions}"
                              SelectedValue="{Binding CompletionFilter, Mode=TwoWay}"
                              SelectedValuePath="Value" />
                </StackPanel>
                <StackPanel Grid.Column="2"
                            Margin="0,0,12,0">
                    <TextBlock Margin="0,0,0,4"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="対象" />
                    <ComboBox DisplayMemberPath="Label"
                              ItemsSource="{Binding ContentOptions}"
                              SelectedItem="{Binding SelectedContentOption, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="3"
                            Margin="0,0,12,0">
                    <TextBlock Margin="0,0,0,4"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="地域" />
                    <ComboBox DisplayMemberPath="Label"
                              ItemsSource="{Binding RegionOptions}"
                              SelectedItem="{Binding SelectedRegionOption, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Margin="0,0,0,4"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="固有名詞" />
                    <ComboBox DisplayMemberPath="Label"
                              ItemsSource="{Binding LanguageOptions}"
                              SelectedValue="{Binding DisplayLanguage, Mode=TwoWay}"
                              SelectedValuePath="Value" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="0"
                    Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Margin="14,12,14,10"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Text="地域別進捗" />
                    <DataGrid Grid.Row="1"
                              BorderThickness="0"
                              ItemsSource="{Binding Regions}"
                              SelectedItem="{Binding SelectedRegion, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*"
                                                Header="地域"
                                                Binding="{Binding Name, Mode=OneWay}" />
                            <DataGridTextColumn Width="62"
                                                Header="撃破"
                                                Binding="{Binding Defeated, Mode=OneWay}" />
                            <DataGridTextColumn Width="62"
                                                Header="総数"
                                                Binding="{Binding Total, Mode=OneWay}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="0"
                    Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0"
                               Margin="14,12,14,10">
                        <TextBlock DockPanel.Dock="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{Binding VisibleBossCountText}" />
                        <TextBlock FontSize="17"
                                   FontWeight="SemiBold"
                                   Text="ボス一覧" />
                    </DockPanel>
                    <DataGrid Grid.Row="1"
                              BorderThickness="0"
                              ItemsSource="{Binding Bosses}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="88"
                                                    Header="状態">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource WarningBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDefeated}"
                                                                     Value="True">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource SuccessBrush}" />
                                                            <Setter Property="FontWeight"
                                                                    Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="2*"
                                                MinWidth="180"
                                                Header="ボス名"
                                                Binding="{Binding Name, Mode=OneWay}" />
                            <DataGridTextColumn Width="1.4*"
                                                MinWidth="140"
                                                Header="地域"
                                                Binding="{Binding Region, Mode=OneWay}" />
                            <DataGridTextColumn Width="1.6*"
                                                MinWidth="160"
                                                Header="場所"
                                                Binding="{Binding Location, Mode=OneWay}" />
                            <DataGridTextColumn Width="70"
                                                Header="区分"
                                                Binding="{Binding ContentText, Mode=OneWay}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="4"
                   Margin="0,10,0,0">
            <TextBlock DockPanel.Dock="Right"
                       Foreground="{DynamicResource TextMutedBrush}">
                <Run Text="セーブ更新日時: " />
                <Run Text="{Binding SaveLastWriteTimeText, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Foreground="{DynamicResource TextMutedBrush}"
                       Text="セーブファイルは読み取り専用で扱います。" />
        </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="OBS出力">
                <ScrollViewer Margin="0,14,0,0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Margin="0,0,0,12"
                                Style="{StaticResource PanelBorderStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right"
                                            HorizontalAlignment="Right">
                                    <TextBlock HorizontalAlignment="Right"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Text="最終出力" />
                                    <TextBlock HorizontalAlignment="Right"
                                               FontWeight="SemiBold"
                                               Text="{Binding ObsLastOutputTimeText}" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                    <CheckBox Margin="0,0,18,0"
                                              Content="OBSテキスト出力を有効にする"
                                              IsChecked="{Binding IsObsOutputEnabled, Mode=TwoWay}"
                                              IsEnabled="{Binding IsInteractionEnabled}" />
                                    <TextBlock Foreground="{DynamicResource TextMutedBrush}"
                                               Text="状態: " />
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding ObsOutputStatusText}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="0.95*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Style="{StaticResource PanelBorderStyle}">
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,16"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Text="基本設定" />

                                    <TextBlock Margin="0,0,0,4"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Text="出力先" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Margin="0,0,8,0"
                                                 IsReadOnly="True"
                                                 Text="{Binding ObsOutputDirectory, Mode=OneWay}"
                                                 ToolTip="{Binding ObsOutputDirectory}" />
                                        <Button Grid.Column="1"
                                                MinWidth="104"
                                                Command="{Binding BrowseObsOutputFolderCommand}"
                                                Content="出力先を選択" />
                                    </Grid>

                                    <TextBlock Margin="0,16,0,4"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Text="出力言語" />
                                    <ComboBox DisplayMemberPath="Label"
                                              ItemsSource="{Binding LanguageOptions}"
                                              SelectedValue="{Binding DisplayLanguage, Mode=TwoWay}"
                                              SelectedValuePath="Value" />

                                    <Separator Margin="0,18"
                                               Background="{DynamicResource BorderBrush}" />
                                    <TextBlock Margin="0,0,0,10"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Text="出力ファイル" />
                                    <UniformGrid Columns="2">
                                        <TextBlock Margin="0,4" Text="✓ progress.txt" />
                                        <TextBlock Margin="0,4" Text="✓ defeated.txt" />
                                        <TextBlock Margin="0,4" Text="✓ remaining.txt" />
                                        <TextBlock Margin="0,4" Text="✓ total.txt" />
                                        <TextBlock Margin="0,4" Text="✓ percentage.txt" />
                                        <TextBlock Margin="0,4" Text="✓ latest_boss.txt" />
                                        <TextBlock Margin="0,4" Text="✓ snapshot.json" />
                                    </UniformGrid>
                                    <TextBlock Margin="0,10,0,0"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Text="現在はすべてのファイルを自動生成します。"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Padding="0"
                                    Style="{StaticResource PanelBorderStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0"
                                               Margin="14,12,14,10">
                                        <TextBlock DockPanel.Dock="Right"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="現在の内容" />
                                        <TextBlock FontSize="17"
                                                   FontWeight="SemiBold"
                                                   Text="ライブプレビュー" />
                                    </DockPanel>
                                    <DataGrid Grid.Row="1"
                                              MinHeight="300"
                                              BorderThickness="0"
                                              ItemsSource="{Binding ObsPreviewItems}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Width="150"
                                                                Header="ファイル名"
                                                                Binding="{Binding FileName, Mode=OneWay}" />
                                            <DataGridTextColumn Width="*"
                                                                Header="現在の内容"
                                                                Binding="{Binding Contents, Mode=OneWay}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <DockPanel Grid.Row="2"
                                               Margin="14,12">
                                        <Button DockPanel.Dock="Right"
                                                MinWidth="120"
                                                Command="{Binding TestObsOutputCommand}"
                                                Content="テスト出力" />
                                        <TextBlock VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="OBSのテキスト（GDI+）ソースから各ファイルを参照できます。"
                                                   TextWrapping="Wrap" />
                                    </DockPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Grid.Row="2"
                                Margin="0,12,0,0"
                                Style="{StaticResource PanelBorderStyle}">
                            <StackPanel>
                                <TextBlock FontSize="17"
                                           FontWeight="SemiBold"
                                           Text="現在の進捗表示書式" />
                                <TextBox Margin="0,10,0,0"
                                         IsReadOnly="True"
                                         Text="{}{defeated} / {total} ({percentage}%)" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="書式の編集機能は次の調整段階で追加できます。"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="設定">
                <ScrollViewer Margin="0,14,0,0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0"
                                Grid.Column="0"
                                Style="{StaticResource PanelBorderStyle}">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,16"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Text="表示設定" />
                                <CheckBox Content="ダークモード"
                                          IsChecked="{Binding IsDarkMode, Mode=TwoWay}" />
                                <TextBlock Margin="0,16,0,4"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="固有名詞" />
                                <ComboBox DisplayMemberPath="Label"
                                          ItemsSource="{Binding LanguageOptions}"
                                          SelectedValue="{Binding DisplayLanguage, Mode=TwoWay}"
                                          SelectedValuePath="Value" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0"
                                Grid.Column="2"
                                Style="{StaticResource PanelBorderStyle}">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,16"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Text="セーブファイルと監視" />
                                <TextBlock Margin="0,0,0,4"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="現在のセーブファイル" />
                                <TextBox IsReadOnly="True"
                                         Text="{Binding SelectedSaveCandidate.FilePath, Mode=OneWay}"
                                         ToolTip="{Binding SelectedSaveCandidate.FilePath}" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Margin="0,0,8,0"
                                            Command="{Binding BrowseFolderCommand}"
                                            Content="フォルダーを変更" />
                                    <Button Command="{Binding RefreshDefaultCommand}"
                                            Content="既定場所を再検索" />
                                </WrapPanel>
                                <CheckBox Margin="0,16,0,0"
                                          Content="自動監視"
                                          IsChecked="{Binding IsAutoMonitoringEnabled, Mode=TwoWay}"
                                          IsEnabled="{Binding IsInteractionEnabled}" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="セーブ更新を検出すると進捗を自動で再読み込みします。"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Margin="0,12,0,0"
                                Style="{StaticResource PanelBorderStyle}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="変更内容は自動的に保存されます。" />
                                <StackPanel>
                                    <TextBlock FontSize="17"
                                               FontWeight="SemiBold"
                                               Text="アプリ情報" />
                                    <TextBlock Margin="0,8,0,0"
                                               FontWeight="SemiBold"
                                               Text="ER Boss Tracker JP" />
                                    <TextBlock Foreground="{DynamicResource TextMutedBrush}"
                                               Text="{Binding ApplicationVersionText}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
